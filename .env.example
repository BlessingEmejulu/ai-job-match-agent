# ---- Actor (set as secret environment variables in Apify Console > Actor > Source > Environment variables) ----
# Optional. Enables the bounded AI extraction step when the run input has ai.enabled = true.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
# Owner-side cap on AI analyses per run. AI calls are paid with the owner's key, so the default
# (unset / 0) keeps AI off for every caller regardless of input.
AI_MAX_ANALYSES_CAP=0

# ---- Local PPE testing (see docs/monetization.md) ----
# ACTOR_TEST_PAY_PER_EVENT=true
# ACTOR_USE_CHARGING_LOG_DATASET=true
# ACTOR_MAX_TOTAL_CHARGE_USD=3

# ---- Website (web/.env.local, or Vercel project environment variables) ----
# Server-side only. Never prefix these with NEXT_PUBLIC_.
APIFY_TOKEN=
# Actor to run, e.g. <apify-username>~ai-job-match-agent
APIFY_ACTOR_ID=
# Dataset id of a completed, profile-free showcase run for the public read-only page.
APIFY_SHOWCASE_DATASET_ID=
# Shared access code for the protected live-run page, and a long random secret for signing sessions.
LIVE_ACCESS_CODE=
SESSION_SECRET=
# Server-side caps for live runs started from the website.
LIVE_MAX_RESULTS=10
LIVE_MAX_TOTAL_CHARGE_USD=0.5
LIVE_MAX_RUNS_PER_DAY=20
# Upstash Redis REST credentials for persistent rate limits (required in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
